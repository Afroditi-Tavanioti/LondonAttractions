<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Ρίζα -->
  <xs:element name="London_Sightseeing">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Title" type="xs:string"/>
        <xs:element name="Special_Offers" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="LondonAttractions" maxOccurs="unbounded"/>
        <xs:element name="must_sees" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Special_Offers -->
  <xs:element name="Special_Offers">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Offer" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Special_Offer">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Adult">
                      <xs:complexType>
                        <xs:attribute name="unit_price" type="xs:string" use="required"/>
                        <xs:attribute name="price" type="xs:string" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="child">
                      <xs:complexType>
                        <xs:attribute name="unit_price" type="xs:string" use="required"/>
                        <xs:attribute name="price" type="xs:string" use="required"/>
                        <xs:attribute name="age" type="xs:string" use="required" fixed="5-15"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="id" type="xs:ID" use="required"/>
                  <xs:attribute name="days" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="1"/>
                        <xs:enumeration value="2"/>
                        <xs:enumeration value="3"/>
                        <xs:enumeration value="4"/>
                        <xs:enumeration value="5"/>
                        <xs:enumeration value="6"/>
                        <xs:enumeration value="7"/>
                        <xs:enumeration value="10"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>

              <xs:element name="Offer_including">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="including_o" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:simpleContent>
                          <xs:extension base="xs:string">
                            <xs:attribute name="id" type="xs:ID" use="optional"/>
                          </xs:extension>
                        </xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="name" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- LondonAttractions -->
  <xs:element name="LondonAttractions">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Attraction" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="URL" type="xs:string"/>
              <xs:element name="small_description" type="xs:string"/>
              <xs:element name="Attraction_title" type="xs:string"/>
              <xs:element name="extra_attraction_info">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="spending_time" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="doing">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="value_d" type="xs:string"/>
                    <xs:element name="Highlights" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Highlight" type="xs:string" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Facts" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Fact" type="xs:string" maxOccurs="unbounded"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="title" type="xs:string" use="required" fixed="What you'll do"/>
                </xs:complexType>
              </xs:element>

              <xs:element name="includings" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="including" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                          <xs:element name="Not_in" type="xs:string" minOccurs="0"/>
                          <xs:any minOccurs="0" processContents="lax"/>
                        </xs:choice>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="title" type="xs:string" use="required" fixed="What's included"/>
                </xs:complexType>
              </xs:element>

              <xs:element name="Facts" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Fact" type="xs:string" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element name="Reservations" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="value" type="xs:string" minOccurs="0"/>
                    <xs:element name="procedure" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="step" type="xs:string" maxOccurs="unbounded"/>
                          <xs:element name="value" type="xs:string" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="booking_notes" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
			  
			  <xs:element name="Knowing_before" minOccurs="0">
                <xs:complexType>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="Facilities" type="xs:string"/>
                    <xs:element name="Getting_in" type="xs:string"/>
                    <xs:element name="Busy_tip" type="xs:string"/>
                    <xs:element name="note" type="xs:string"/>
                    <xs:element name="Disclaimer" type="xs:string"/>
                    <xs:element name="Accessibility" type="xs:string"/>
                  </xs:choice>
                  <xs:attribute name="title" type="xs:string" fixed="Know before you go" use="optional"/>
                </xs:complexType>
              </xs:element>

              <xs:element name="Note" minOccurs="0">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="title" type="xs:string" use="required" fixed="Please Note"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>

              <xs:element name="Address">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="title" type="xs:string" use="required" fixed="Where you'll be"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
			  
			  <xs:element name="operating" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Monday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Tuesday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Wednesday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Thursday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Friday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Saturday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Sunday" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Timing" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                        <xs:attribute name="dayid" type="xs:ID" use="required"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="openings" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="opening" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:string">
                                  <xs:attribute name="for" type="xs:string" use="optional"/>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                        <xs:attribute name="variable_dates" type="xs:string" use="optional"/>
                        <xs:attribute name="for" type="xs:string" use="optional"/>
                        <xs:attribute name="days" type="xs:IDREFS" use="optional"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="special_closings" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="date" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="value" type="xs:string" use="required"/>
                              <xs:attribute name="note" type="xs:string" use="optional"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="closing" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="days" minOccurs="0" type="xs:string"/>
                          <xs:element name="match_days" minOccurs="0" maxOccurs="unbounded" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="specific_dates" type="xs:string" use="optional"/>
                        <xs:attribute name="days" type="xs:string" use="optional"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Notice" minOccurs="0" type="xs:string"/>
              <xs:element name="For_more" minOccurs="0">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="title" type="xs:string" fixed="Find out More" use="optional"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="FAQS" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="FAQ" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="question" type="xs:string"/>
                          <xs:element name="answer" type="xs:string"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="getting_there" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Buses" type="xs:string" minOccurs="0"/>
                    <xs:element name="Train" type="xs:string" minOccurs="0"/>
                    <xs:element name="Other" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                  <xs:attribute name="title" type="xs:string" fixed="How to get there" use="optional"/>
                </xs:complexType>
              </xs:element>


            </xs:sequence>
            <xs:attribute name="id_Attr" type="xs:ID" use="required"/>
            <xs:attribute name="booking" use="optional">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="required"/>
                  <xs:enumeration value="not_required"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="normal_value" type="xs:string" use="optional"/>
            <xs:attribute name="unit_value" type="xs:string" use="required" fixed="£"/>
            <xs:attribute name="in_offer" type="xs:IDREFS" use="optional"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- must_sees -->
  <xs:element name="must_sees">
    <xs:complexType>
      <xs:attribute name="ids" type="xs:IDREFS" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>